# Configuracion de correo (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=tu-cuenta@gmail.com
EMAIL_HOST_PASSWORD=contraseña-de-aplicacion-de-16-caracteres
DEFAULT_FROM_EMAIL=Mi Botiquín Digital <tu-cuenta@gmail.com>

# Tiempo de validez del enlace de recuperacion (segundos)
PASSWORD_RESET_TIMEOUT=86400

# URL publica de la app (ej. tunel ngrok). Se usa en los enlaces de los correos.
SITE_URL=

# Hosts y origenes permitidos (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
