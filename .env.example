# Copia este archivo a .env y completa los valores. NO subas .env a GitHub.

# --- Django ---------------------------------------------------------------
# Para desarrollo y demostraciones locales (con ngrok) usa True.
# Con False (producción) DJANGO_SECRET_KEY es obligatoria.
DJANGO_DEBUG=True
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Pon True solo si la app está detrás de un túnel HTTPS (ngrok, cloudflared).
DJANGO_TRAS_PROXY_HTTPS=False

# --- Hosts y orígenes -----------------------------------------------------
# Hosts permitidos, separados por coma. Para ngrok añade el dominio público.
ALLOWED_HOSTS=localhost,127.0.0.1
# Si se deja vacío, se derivan de ALLOWED_HOSTS (https://dominio).
# Ejemplo con ngrok: https://demo-abc.ngrok-free.app
CSRF_TRUSTED_ORIGINS=
# URL pública de la app. Se usa en los enlaces de los correos.
SITE_URL=

# --- Correo (Gmail SMTP) ---------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=tu-cuenta@gmail.com
# Contraseña de aplicación de 16 caracteres (no la contraseña normal de Gmail)
EMAIL_HOST_PASSWORD=contraseña-de-aplicacion-de-16-caracteres
DEFAULT_FROM_EMAIL=Mi Botiquín Digital <tu-cuenta@gmail.com>
