# Copia este archivo a .env y completa los valores. NO subas .env a GitHub.

# --- Django ---------------------------------------------------------------
# Para desarrollo y demostraciones locales (con ngrok) usa True.
# Con False (producción) DJANGO_SECRET_KEY es obligatoria.
DJANGO_DEBUG=True
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Pon True solo si la app está detrás de un túnel HTTPS (ngrok, cloudflared).
DJANGO_TRAS_PROXY_HTTPS=False

# --- Seguridad HTTPS (se activan por defecto con DJANGO_DEBUG=False) ------
# Redirección de todo el tráfico a HTTPS.
DJANGO_SECURE_SSL_REDIRECT=False
# Cookies de sesión y CSRF solo por HTTPS.
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
# Tiempo de HSTS en segundos (0 = desactivado). 31536000 = 1 año.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# --- Hosts y orígenes -----------------------------------------------------
# Hosts permitidos, separados por coma. Para ngrok añade el dominio público.
# Para pruebas en red local (LAN) deja ALLOWED_HOSTS vacío en DEBUG (se acepta *).
ALLOWED_HOSTS=localhost,127.0.0.1
# Si se deja vacío, se derivan de ALLOWED_HOSTS (https://dominio).
# Ejemplo con ngrok: https://demo-abc.ngrok-free.app
CSRF_TRUSTED_ORIGINS=
# URL pública de la app. Se usa en los enlaces de los correos.
SITE_URL=

# --- Acceso en red local (LAN) --------------------------------------------
# Con DJANGO_DEBUG=True y ALLOWED_HOSTS vacío se acepta cualquier host (LAN + túnel).
# Inicia el servidor con:  python manage.py runserver 0.0.0.0:8000
# o ejecuta run_lan.ps1 (Windows) / run_lan.sh (Linux/macOS).

# --- Correo (Gmail SMTP) ---------------------------------------------------
# Backend estándar de Django (locmem para pruebas, console en desarrollo).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=tu-cuenta@gmail.com
# Contraseña de aplicación de 16 caracteres (no la contraseña normal de Gmail)
EMAIL_HOST_PASSWORD=contraseña-de-aplicacion-de-16-caracteres
DEFAULT_FROM_EMAIL=Mi Botiquín Digital <tu-cuenta@gmail.com>
# Tiempo máximo de espera del servidor SMTP (segundos).
EMAIL_TIMEOUT=10

# --- Contraseña y avisos --------------------------------------------------
# Vigencia del enlace de restablecimiento de contraseña (segundos).
PASSWORD_RESET_TIMEOUT=86400

# --- WhatsApp (opcional) --------------------------------------------------
# Si se define, los recordatorios también se envían por WhatsApp.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# --- Páginas públicas e institucionales ------------------------------------
# Datos que aparecen en la portada, la página institucional y los textos
# legales. Si se dejan vacíos se usan los valores por defecto de
# publico/contenido.py (UPTC, Sogamoso-Boyacá).
CONTACTO_CORREO=
INSTITUCION_NOMBRE=
INSTITUCION_SIGLA=
INSTITUCION_FACULTAD=
INSTITUCION_SEDE=
INSTITUCION_AUTORA=
INSTITUCION_CODIGO=
PROYECTO_ENFOQUE=Regencia de Farmacia
